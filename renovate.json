{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Component versions held in terraform variable defaults, annotated with a renovate: comment",
      "managerFilePatterns": [
        "/(^|/)variables\\.tf$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?(?:\\s+extractVersion=(?<extractVersion>\\S+))?(?:\\s+registryUrl=(?<registryUrl>\\S+))?[\\s\\S]*?default\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ]
}
